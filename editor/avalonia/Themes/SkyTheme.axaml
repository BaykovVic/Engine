<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Avalonia-valid styling derived from the design tokens (SkyDark.axaml).
       Single-type selectors only — the design's SkyStyles.axaml uses
       multi-type selectors that Avalonia validates against their common base
       Control, so it needs a compat pass before it can be used directly. -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource SkyTextMutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource SkyFontMono}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Panel chrome: a titled dock-like surface -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
  </Style>
  <Style Selector="Border.panelHeader">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style Selector="Border.panelHeader TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Toolbar -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="Padding" Value="14,0"/>
  </Style>
  <Style Selector="Border.toolGroup">
    <Setter Property="Background" Value="{StaticResource SkyAppBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="ToggleButton.tool">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.tool:checked">
    <Setter Property="Background" Value="{StaticResource SkyAccentTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyAccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource SkyAccentHoverBrush}"/>
  </Style>

  <!-- Path icons -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
  </Style>
  <Style Selector="Path.iconFilled">
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
  </Style>

  <!-- Cards / group boxes -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="12"/>
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Scene header / view-mode toggle -->
  <Style Selector="Border.sceneHeader">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>
  <Style Selector="ToggleButton.viewMode">
    <Setter Property="Background" Value="{StaticResource SkyInsetBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="Padding" Value="12,3"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="ToggleButton.viewMode:checked">
    <Setter Property="Background" Value="{StaticResource SkyAccentTintBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyAccentBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource SkyAccentHoverBrush}"/>
  </Style>

  <!-- Trees & lists -->
  <Style Selector="TreeView">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
    <Setter Property="Padding" Value="6,4"/>
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SkyInsetBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/>
    <Setter Property="CornerRadius" Value="7"/>
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="16,7"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource SkyAccentBrush}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- Tabs -->
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
  </Style>

  <!-- Menu -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{StaticResource SkyAppBrush}"/>
  </Style>
  <Style Selector="Menu > MenuItem">
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="Padding" Value="10,5"/>
  </Style>

  <!-- Status bar -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{StaticResource SkyAppBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style Selector="Border.statusbar TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SkyTextMutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{StaticResource SkyAppBrush}"/>
  </Style>
</Styles>

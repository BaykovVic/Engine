<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Avalonia-valid theme matching the Sky Engine design, built from the
       SkyDark.axaml tokens. Single-type selectors + pseudo-classes only. -->

  <!-- ============ Text ============ -->
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/></Style>
  <Style Selector="TextBlock.secondary"><Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource SkyTextMutedBrush}"/><Setter Property="FontSize" Value="11"/></Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource SkyFontMono}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="TextBlock.sectionTitle"><Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/></Style>

  <!-- ============ Icons ============ -->
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
  </Style>
  <Style Selector="Path.iconFilled">
    <Setter Property="Fill" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/>
  </Style>
  <Style Selector="Path.iconSmall"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/></Style>

  <!-- ============ Menu ============ -->
  <Style Selector="Menu"><Setter Property="Background" Value="{StaticResource SkyAppBrush}"/><Setter Property="Padding" Value="6,2"/></Style>
  <Style Selector="Menu > MenuItem"><Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/><Setter Property="Padding" Value="10,6"/><Setter Property="CornerRadius" Value="5"/></Style>
  <Style Selector="MenuItem"><Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/></Style>

  <!-- ============ Toolbar ============ -->
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineStrongBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="56"/><Setter Property="Padding" Value="16,0"/>
  </Style>
  <Style Selector="Border.toolGroup">
    <Setter Property="Background" Value="{StaticResource SkyAppBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="4"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SkyCardBrush}"/>
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource SkyAccentTintBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SkyAccentBrush}"/>
  </Style>
  <Style Selector="ToggleButton.tool:checked Path.icon"><Setter Property="Stroke" Value="{StaticResource SkyAccentHoverBrush}"/></Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,6"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
  </Style>

  <!-- ============ Panels & headers ============ -->
  <Style Selector="Border.panel"><Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/></Style>
  <Style Selector="Border.panelHeader">
    <Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineStrongBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Height" Value="40"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style Selector="Border.panelHeader TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <!-- ============ TreeView (Hierarchy) ============ -->
  <Style Selector="TreeView"><Setter Property="Background" Value="{StaticResource SkyPanelBrush}"/><Setter Property="Padding" Value="6,4"/></Style>
  <Style Selector="TreeViewItem"><Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="26"/></Style>
  <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot"><Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="0,1"/></Style>
  <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{StaticResource SkyCardBrush}"/></Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{StaticResource SkyAccentTintBrush}"/></Style>
  <Style Selector="TreeViewItem:selected"><Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/></Style>

  <!-- ============ Tabs ============ -->
  <Style Selector="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter > WrapPanel"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="2,0"/><Setter Property="Margin" Value="0,0,18,0"/>
    <Setter Property="MinHeight" Value="40"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/></Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="BorderBrush" Value="{StaticResource SkyAccentBrush}"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
  </Style>

  <!-- ============ Cards (Inspector) ============ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SkyCardBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style Selector="TextBlock.cardTitle"><Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <!-- ============ Axis labels ============ -->
  <Style Selector="TextBlock.axisX"><Setter Property="Foreground" Value="{StaticResource SkyAxisXBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.axisY"><Setter Property="Foreground" Value="{StaticResource SkyAxisYBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.axisZ"><Setter Property="Foreground" Value="{StaticResource SkyAxisZBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.fieldLabel"><Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <!-- ============ Inputs ============ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SkyInsetBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource SkyAccentBrush}"/>
    <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/></Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{StaticResource SkyAccentBrush}"/></Style>
  <Style Selector="TextBox.field"><Setter Property="FontFamily" Value="{StaticResource SkyFontMono}"/></Style>

  <!-- ============ Buttons ============ -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource SkyCardBrush}"/><Setter Property="Foreground" Value="{StaticResource SkyTextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineStrongBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14,7"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#313742"/><Setter Property="BorderBrush" Value="#444B57"/></Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource SkyAccentBrush}"/><Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource SkyAccentHoverBrush}"/></Style>
  <Style Selector="Button.iconButton"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="5"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource SkyCardBrush}"/></Style>

  <!-- ============ Scene header chips ============ -->
  <Style Selector="ToggleButton.viewMode">
    <Setter Property="Background" Value="{StaticResource SkyInsetBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource SkyTextSecondaryBrush}"/>
    <Setter Property="Padding" Value="11,3"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="ToggleButton.viewMode:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource SkyAccentTintBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SkyAccentBrush}"/></Style>
  <Style Selector="ToggleButton.viewMode:checked"><Setter Property="Foreground" Value="{StaticResource SkyAccentHoverBrush}"/></Style>

  <!-- ============ Badge ============ -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="#29E0A53B"/><Setter Property="BorderBrush" Value="{StaticResource SkyWarnBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="12,4"/>
  </Style>
  <Style Selector="Border.badge TextBlock"><Setter Property="Foreground" Value="{StaticResource SkyWarnBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/></Style>
  <Style Selector="Border.countBadge"><Setter Property="Background" Value="{StaticResource SkyErrorBrush}"/><Setter Property="CornerRadius" Value="9"/><Setter Property="MinWidth" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Padding" Value="5,0"/></Style>
  <Style Selector="Border.countBadge TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <!-- ============ Project grid (ListBox) ============ -->
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8"/></Style>
  <Style Selector="ListBoxItem"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="6"/></Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource SkyCardBrush}"/></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{StaticResource SkyAccentTintBrush}"/></Style>

  <!-- ============ Status bar ============ -->
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{StaticResource SkyAppBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SkyLineStrongBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style Selector="Border.statusbar TextBlock"><Setter Property="Foreground" Value="{StaticResource SkyTextMutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <Style Selector="GridSplitter"><Setter Property="Background" Value="{StaticResource SkyAppBrush}"/></Style>
  <Style Selector="ScrollBar"><Setter Property="Background" Value="Transparent"/><Setter Property="AllowAutoHide" Value="True"/></Style>
</Styles>

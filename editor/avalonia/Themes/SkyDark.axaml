<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ====================================================================
          SKY ENGINE — Dark theme tokens (Avalonia 11)
          Merge into App.axaml:
              <Application.Resources>
                <ResourceDictionary>
                  <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude Source="avares://SkyEngine/Themes/SkyDark.axaml"/>
                  </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
              </Application.Resources>
          Then add SkyStyles.axaml to <Application.Styles> (after FluentTheme + Dock).
          ==================================================================== -->

    <!-- ============================ COLORS ============================ -->
    <Color x:Key="SkyApp">#15171C</Color>          <!-- app background (darkest)   -->
    <Color x:Key="SkyPanel">#1C1F26</Color>         <!-- docked panels              -->
    <Color x:Key="SkyCard">#23262E</Color>          <!-- cards / group boxes         -->
    <Color x:Key="SkyInset">#101216</Color>         <!-- recessed inputs             -->
    <Color x:Key="SkyLine">#2C313A</Color>          <!-- dividers / borders          -->
    <Color x:Key="SkyLineStrong">#3A404B</Color>    <!-- hover borders / handles     -->

    <Color x:Key="SkyTextPrimary">#E7E9ED</Color>
    <Color x:Key="SkyTextSecondary">#9AA1AD</Color>
    <Color x:Key="SkyTextMuted">#646B77</Color>
    <Color x:Key="SkyTextDisabled">#525965</Color>

    <Color x:Key="SkyAccent">#3B7DF6</Color>
    <Color x:Key="SkyAccentHover">#5A93F8</Color>
    <Color x:Key="SkyAccentPressed">#2E6AE0</Color>
    <Color x:Key="SkyAccentTint">#293B7DF6</Color>   <!-- accent @ 16% alpha          -->

    <Color x:Key="SkyInfo">#5A93F8</Color>
    <Color x:Key="SkyWarn">#E0A53B</Color>
    <Color x:Key="SkyError">#E5484D</Color>
    <Color x:Key="SkyPlay">#3FB950</Color>

    <Color x:Key="SkyAxisX">#F0626E</Color>
    <Color x:Key="SkyAxisY">#62C76E</Color>
    <Color x:Key="SkyAxisZ">#5B8DEF</Color>

    <!-- Drive Fluent's accent so built-in pseudo-states match the palette -->
    <Color x:Key="SystemAccentColor">#3B7DF6</Color>
    <Color x:Key="SystemAccentColorLight1">#5A93F8</Color>
    <Color x:Key="SystemAccentColorDark1">#2E6AE0</Color>

    <!-- ============================ BRUSHES =========================== -->
    <SolidColorBrush x:Key="SkyAppBrush"          Color="{StaticResource SkyApp}"/>
    <SolidColorBrush x:Key="SkyPanelBrush"        Color="{StaticResource SkyPanel}"/>
    <SolidColorBrush x:Key="SkyCardBrush"         Color="{StaticResource SkyCard}"/>
    <SolidColorBrush x:Key="SkyInsetBrush"        Color="{StaticResource SkyInset}"/>
    <SolidColorBrush x:Key="SkyLineBrush"         Color="{StaticResource SkyLine}"/>
    <SolidColorBrush x:Key="SkyLineStrongBrush"   Color="{StaticResource SkyLineStrong}"/>

    <SolidColorBrush x:Key="SkyTextPrimaryBrush"   Color="{StaticResource SkyTextPrimary}"/>
    <SolidColorBrush x:Key="SkyTextSecondaryBrush" Color="{StaticResource SkyTextSecondary}"/>
    <SolidColorBrush x:Key="SkyTextMutedBrush"     Color="{StaticResource SkyTextMuted}"/>
    <SolidColorBrush x:Key="SkyTextDisabledBrush"  Color="{StaticResource SkyTextDisabled}"/>

    <SolidColorBrush x:Key="SkyAccentBrush"        Color="{StaticResource SkyAccent}"/>
    <SolidColorBrush x:Key="SkyAccentHoverBrush"   Color="{StaticResource SkyAccentHover}"/>
    <SolidColorBrush x:Key="SkyAccentPressedBrush" Color="{StaticResource SkyAccentPressed}"/>
    <SolidColorBrush x:Key="SkyAccentTintBrush"    Color="{StaticResource SkyAccentTint}"/>

    <SolidColorBrush x:Key="SkyInfoBrush"  Color="{StaticResource SkyInfo}"/>
    <SolidColorBrush x:Key="SkyWarnBrush"  Color="{StaticResource SkyWarn}"/>
    <SolidColorBrush x:Key="SkyErrorBrush" Color="{StaticResource SkyError}"/>
    <SolidColorBrush x:Key="SkyPlayBrush"  Color="{StaticResource SkyPlay}"/>

    <SolidColorBrush x:Key="SkyAxisXBrush" Color="{StaticResource SkyAxisX}"/>
    <SolidColorBrush x:Key="SkyAxisYBrush" Color="{StaticResource SkyAxisY}"/>
    <SolidColorBrush x:Key="SkyAxisZBrush" Color="{StaticResource SkyAxisZ}"/>

    <!-- ============================ FONTS ============================= -->
    <FontFamily x:Key="SkyFontUi">Segoe UI, San Francisco, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="SkyFontMono">JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- ========================= FONT SIZES ========================== -->
    <x:Double x:Key="SkyFontTitle">17</x:Double>     <!-- panel / dialog title  -->
    <x:Double x:Key="SkyFontSection">13</x:Double>   <!-- card / section title  -->
    <x:Double x:Key="SkyFontBody">13</x:Double>      <!-- body / control text   -->
    <x:Double x:Key="SkyFontLabel">12</x:Double>     <!-- field labels          -->
    <x:Double x:Key="SkyFontHint">11</x:Double>      <!-- hints / captions      -->
    <x:Double x:Key="SkyFontMonoSize">12</x:Double>  <!-- console / numerics    -->

    <!-- =========================== RADII ============================= -->
    <CornerRadius x:Key="SkyRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="SkyRadiusButton">7</CornerRadius>
    <CornerRadius x:Key="SkyRadiusCard">9</CornerRadius>
    <CornerRadius x:Key="SkyRadiusPanel">11</CornerRadius>
    <CornerRadius x:Key="SkyRadiusPill">20</CornerRadius>

    <!-- ===================== SPACING (Thickness) ===================== -->
    <Thickness x:Key="SkySpace1">4</Thickness>
    <Thickness x:Key="SkySpace2">8</Thickness>
    <Thickness x:Key="SkySpace3">12</Thickness>
    <Thickness x:Key="SkySpace4">24</Thickness>
    <Thickness x:Key="SkyPadInput">9,5</Thickness>
    <Thickness x:Key="SkyPadButton">16,7</Thickness>
    <Thickness x:Key="SkyPadCard">12</Thickness>
    <Thickness x:Key="SkyPadMenuItem">12,7</Thickness>
    <Thickness x:Key="SkyBorderThin">1</Thickness>

    <!-- ==================== SIZES (x:Double) ========================= -->
    <x:Double x:Key="SkyRowHeight">28</x:Double>
    <x:Double x:Key="SkyControlHeight">30</x:Double>
    <x:Double x:Key="SkyToolButtonSize">34</x:Double>
    <x:Double x:Key="SkyTabHeight">34</x:Double>
    <x:Double x:Key="SkyToolbarHeight">52</x:Double>
    <x:Double x:Key="SkyStatusHeight">24</x:Double>
    <x:Double x:Key="SkyIconSize">18</x:Double>
    <x:Double x:Key="SkyIconStroke">1.6</x:Double>
    <x:Double x:Key="SkyScrollSize">10</x:Double>

    <!-- ====================================================================
         ICONS — vector Geometry resources (20x20 grid, no raster assets).
         Stroke icons: render with <Path Classes="icon" Data="{...}"/>.
         Filled icons: render with <Path Classes="icon-filled" Data="{...}"/>
         or <PathIcon Data="{...}"/>.
         ==================================================================== -->
    <!-- transform tools -->
    <StreamGeometry x:Key="IconMove">M10 3v14M3 10h14M10 3 8.3 4.8M10 3l1.7 1.8M10 17l-1.7-1.8M10 17l1.7-1.8M3 10l1.8-1.7M3 10l1.8 1.7M17 10l-1.8-1.7M17 10l-1.8 1.7</StreamGeometry>
    <StreamGeometry x:Key="IconRotate">M15.2 10a5.2 5.2 0 1 1-1.6-3.75M15.4 5.6v3.2h-3.2</StreamGeometry>
    <StreamGeometry x:Key="IconScale">M4 8.5V4h4.5M4 4l5.5 5.5M16 11.5V16h-4.5M16 16l-5.5-5.5</StreamGeometry>
    <StreamGeometry x:Key="IconHand">M7.2 9.5V5.6a1.15 1.15 0 0 1 2.3 0V9M9.5 8.8V4.9a1.15 1.15 0 0 1 2.3 0V9M11.8 9V6.4a1.15 1.15 0 0 1 2.3 0v6a4.3 4.3 0 0 1-4.3 4.3H9a4.3 4.3 0 0 1-3.5-1.8l-1.6-2.3a1.15 1.15 0 0 1 1.85-1.36L7.2 12</StreamGeometry>
    <!-- transport (filled) -->
    <StreamGeometry x:Key="IconPlay">M6.5 4.7 15 10l-8.5 5.3z</StreamGeometry>
    <StreamGeometry x:Key="IconPause">M7.2 4.6h2.1v10.8H7.2zM10.7 4.6h2.1v10.8h-2.1z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M6.4 6h7.2a.4 .4 0 0 1 .4.4v7.2a.4 .4 0 0 1-.4.4H6.4a.4 .4 0 0 1-.4-.4V6.4A.4 .4 0 0 1 6.4 6z</StreamGeometry>
    <!-- hierarchy type glyphs -->
    <StreamGeometry x:Key="IconMesh">M10 3 4 6.3v7L10 17l6-3.7v-7L10 3zM4 6.3 10 9.7l6-3.4M10 9.7V17</StreamGeometry>
    <StreamGeometry x:Key="IconLight">M10 3.5v2M10 14.5v2M3.5 10h2M14.5 10h2M5.4 5.4l1.4 1.4M13.2 13.2l1.4 1.4M14.6 5.4l-1.4 1.4M6.8 13.2l-1.4 1.4M10 6.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z</StreamGeometry>
    <StreamGeometry x:Key="IconCamera">M3 8.1a1.6 1.6 0 0 1 1.6-1.6h6.3a1.6 1.6 0 0 1 1.6 1.6v5.4a1.6 1.6 0 0 1-1.6 1.6H4.6A1.6 1.6 0 0 1 3 13.5zM13.5 9.4 16.8 7.6v6l-3.3-1.8</StreamGeometry>
    <StreamGeometry x:Key="IconEmpty">M10 10V4M10 10l5 3M10 10l-5 3</StreamGeometry>
    <StreamGeometry x:Key="IconTerrain">M3 15l4-6 3 3.5 2.5-4L17 15z</StreamGeometry>
    <!-- project / files -->
    <StreamGeometry x:Key="IconFolder">M3 6.3a1.4 1.4 0 0 1 1.4-1.4h2.8L8.8 6.6h6a1.4 1.4 0 0 1 1.4 1.4v6.3a1.4 1.4 0 0 1-1.4 1.4H4.4A1.4 1.4 0 0 1 3 14.3z</StreamGeometry>
    <StreamGeometry x:Key="IconFile">M6 3h5l3 3v10a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM11 3v3h3</StreamGeometry>
    <StreamGeometry x:Key="IconImage">M3.5 6.1a1.6 1.6 0 0 1 1.6-1.6h9.8a1.6 1.6 0 0 1 1.6 1.6v7.8a1.6 1.6 0 0 1-1.6 1.6H5.1a1.6 1.6 0 0 1-1.6-1.6zM7.4 8.5a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6M4.5 14l3.5-3.3 2.4 2.3 2.2-2.2 3 3.2</StreamGeometry>
    <!-- actions -->
    <StreamGeometry x:Key="IconClear">M5 6h10M8 6V4.8a.8 .8 0 0 1 .8-.8h2.4a.8 .8 0 0 1 .8.8V6M6.6 6l.6 9a1 1 0 0 0 1 .9h3.6a1 1 0 0 0 1-.9l.6-9</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M15.5 9A5.5 5.5 0 0 0 6 6.2M4.5 11A5.5 5.5 0 0 0 14 13.8M15.8 5.5V9h-3.5M4.2 14.5V11h3.5</StreamGeometry>
    <StreamGeometry x:Key="IconAdd">M10 4v12M4 10h12</StreamGeometry>
    <StreamGeometry x:Key="IconRemove">M4 10h12</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M5.5 8l4.5 4.5L14.5 8</StreamGeometry>
    <StreamGeometry x:Key="IconChevronRight">M8 5.5 12.5 10 8 14.5</StreamGeometry>
    <StreamGeometry x:Key="IconSearch">M9 4a5 5 0 1 0 0 10A5 5 0 0 0 9 4zM13 13l3.5 3.5</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M5 10.5 8.5 14 15 6.5</StreamGeometry>
    <!-- panel / dock affordances -->
    <StreamGeometry x:Key="IconHierarchy">M5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M5 11a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M5 7v6M5 9.5h4M5 12.5h4M13 8a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M13 11.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3</StreamGeometry>
    <StreamGeometry x:Key="IconInspector">M10 3.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13M10 9v4M10 6.6v.2</StreamGeometry>
    <StreamGeometry x:Key="IconSceneGrid">M3.5 5.5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-9a2 2 0 0 1-2-2zM3.5 8.5h13M3.5 12.5h13M8.5 3.5v13M12.5 3.5v13</StreamGeometry>
    <StreamGeometry x:Key="IconGame">M3 6.8a1.8 1.8 0 0 1 1.8-1.8h10.4a1.8 1.8 0 0 1 1.8 1.8v6.4a1.8 1.8 0 0 1-1.8 1.8H4.8A1.8 1.8 0 0 1 3 13.2zM8.5 8.2 12 10l-3.5 1.8z</StreamGeometry>
    <StreamGeometry x:Key="IconConsole">M5 6l3.5 4L5 14M10 14h5</StreamGeometry>
    <StreamGeometry x:Key="IconLock">M5.5 9h9v6.5h-9zM7.3 9V7.2a2.7 2.7 0 0 1 5.4 0V9</StreamGeometry>
    <StreamGeometry x:Key="IconKebab">M10 4.2a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6M10 8.7a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6M10 13.2a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6</StreamGeometry>

</ResourceDictionary>

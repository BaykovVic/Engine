<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SkyEditor.Converters"
             x:Class="SkyEditor.Views.InspectorView"
             x:CompileBindings="False">
  <ScrollViewer Background="{StaticResource SkyPanelBrush}">
    <StackPanel Margin="12" Spacing="10" IsVisible="{Binding Main.HasSelection}">
      <Grid ColumnDefinitions="Auto,*">
        <CheckBox IsChecked="True" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding Main.SelectedName}"/>
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Classes="cardTitle" Text="Transform"/>
          <Grid ColumnDefinitions="64,*">
            <TextBlock Classes="fieldLabel" Text="Position"/>
            <Grid Grid.Column="1" ColumnDefinitions="*,6,*,6,*">
              <Grid ColumnDefinitions="13,*"><TextBlock Classes="axisX" Text="X"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.PositionX, Mode=TwoWay}"/></Grid>
              <Grid Grid.Column="2" ColumnDefinitions="13,*"><TextBlock Classes="axisY" Text="Y"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.PositionY, Mode=TwoWay}"/></Grid>
              <Grid Grid.Column="4" ColumnDefinitions="13,*"><TextBlock Classes="axisZ" Text="Z"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.PositionZ, Mode=TwoWay}"/></Grid>
            </Grid>
          </Grid>
          <Grid ColumnDefinitions="64,*">
            <TextBlock Classes="fieldLabel" Text="Rotation"/>
            <Grid Grid.Column="1" ColumnDefinitions="*,6,*,6,*">
              <Grid ColumnDefinitions="13,*"><TextBlock Classes="axisX" Text="X"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.RotationX, Mode=TwoWay}"/></Grid>
              <Grid Grid.Column="2" ColumnDefinitions="13,*"><TextBlock Classes="axisY" Text="Y"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.RotationY, Mode=TwoWay}"/></Grid>
              <Grid Grid.Column="4" ColumnDefinitions="13,*"><TextBlock Classes="axisZ" Text="Z"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.RotationZ, Mode=TwoWay}"/></Grid>
            </Grid>
          </Grid>
          <Grid ColumnDefinitions="64,*">
            <TextBlock Classes="fieldLabel" Text="Scale"/>
            <Grid Grid.Column="1" ColumnDefinitions="*,6,*,6,*">
              <Grid ColumnDefinitions="13,*"><TextBlock Classes="axisX" Text="X"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.ScaleX, Mode=TwoWay}"/></Grid>
              <Grid Grid.Column="2" ColumnDefinitions="13,*"><TextBlock Classes="axisY" Text="Y"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.ScaleY, Mode=TwoWay}"/></Grid>
              <Grid Grid.Column="4" ColumnDefinitions="13,*"><TextBlock Classes="axisZ" Text="Z"/><TextBox Grid.Column="1" Classes="field" Text="{Binding Main.ScaleZ, Mode=TwoWay}"/></Grid>
            </Grid>
          </Grid>
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Main.SelectedComponents}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon iconSmall" Data="{Binding Glyph, Converter={x:Static conv:GlyphConverter.Instance}}"/>
                  <TextBlock Classes="cardTitle" Text="{Binding DisplayName}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Fields}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="120,*" Margin="0,2">
                        <TextBlock Classes="fieldLabel" Text="{Binding Name}"/>
                        <TextBox Grid.Column="1" Classes="field" Text="{Binding Value, Mode=TwoWay}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Classes="primary" HorizontalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
          <Path Classes="icon iconSmall" Data="{StaticResource IconAdd}" Stroke="White"/>
          <TextBlock Text="Add Component"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SkyEditor.Converters"
             x:Class="SkyEditor.Views.HierarchyView"
             x:CompileBindings="False">
  <DockPanel Background="{StaticResource SkyPanelBrush}">
    <Border DockPanel.Dock="Top" Padding="10,8">
      <Grid ColumnDefinitions="*,Auto">
        <Border Background="{StaticResource SkyInsetBrush}" CornerRadius="6" Padding="8,5"
                BorderBrush="{StaticResource SkyLineBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="icon iconSmall" Data="{StaticResource IconSearch}"/>
            <TextBlock Classes="muted" Text="Search..." VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Button Grid.Column="1" Classes="iconButton" Margin="6,0,0,0" Click="OnCreate" ToolTip.Tip="Create Cube">
          <Path Classes="icon iconSmall" Data="{StaticResource IconAdd}"/>
        </Button>
      </Grid>
    </Border>
    <TreeView ItemsSource="{Binding Main.Roots}"
              SelectedItem="{Binding Main.SelectedObject, Mode=TwoWay}">
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon iconSmall" Data="{Binding Glyph, Converter={x:Static conv:GlyphConverter.Instance}}"/>
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>

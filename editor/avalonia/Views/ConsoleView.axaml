<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SkyEditor.Converters"
             x:Class="SkyEditor.Views.ConsoleView"
             x:CompileBindings="False">
  <DockPanel Background="{StaticResource SkyPanelBrush}">
    <Border DockPanel.Dock="Top" Classes="panelHeader">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="sectionTitle" Text="Console" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="chip" Content="Clear" Click="OnClear"/>
      </Grid>
    </Border>
    <ScrollViewer Name="Scroll">
      <ItemsControl ItemsSource="{Binding Main.ConsoleLog}" Margin="12,6">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Classes="mono" FontSize="12" Margin="0,1" TextWrapping="Wrap"
                       Text="{Binding Text}"
                       Foreground="{Binding Color, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
